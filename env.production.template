# ─────────────────────────────────────────────────────────────────────────────
# DigiTax — PRODUCTION environment template  (FINISH-LINE Part 4)
#
# Copy to `.env` on the production host and fill every «CHANGE-ME». Nothing here
# is a working default: the file is written so that a value left unfilled FAILS
# LOUDLY rather than quietly running dev behaviour in production.
#
#     cp env.production.template .env && chmod 600 .env
#
# NEVER commit the filled file. `.env` is gitignored in this repo; keep it that
# way. Secrets belong here and in nothing else.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# The canonical name is `digitax` (no underscore). A mismatch between
# POSTGRES_DB and the DATABASE_URL db-name is the two-database disaster from
# workspace CLAUDE.md §4.1 — preflight.sh fails loudly on it.
POSTGRES_USER=digitax
POSTGRES_PASSWORD=CHANGE-ME-strong-random
POSTGRES_DB=digitax
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://digitax:CHANGE-ME-strong-random@postgres:5432/digitax

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME="DigiTax"
# DEBUG=false is load-bearing in production: with it true the OTP is echoed in
# the API response and Swagger auto-auth is available.
DEBUG=false
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000

# openssl rand -hex 32
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
# Exact origins only — never «*» in production.
BACKEND_CORS_ORIGINS=https://app.example.ir

# Swagger's one-click auth is a dev convenience; off in production.
SWAGGER_AUTO_AUTH_ENABLED=false

# ── Frontend (BUILD-TIME — the image must be rebuilt when these change) ──────
VITE_API_BASE_URL=https://app.example.ir/api/v1
VITE_API_TIMEOUT_MS=30000
FRONTEND_PORT=3000

# ── Auth hardening — keep ON ────────────────────────────────────────────────
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BLOCK_SECONDS=300
AUTH_CAPTCHA_ENABLED=true
AUTH_CAPTCHA_MAX_NUMBER=100000
AUTH_CAPTCHA_TTL_SECONDS=300

# ── SMS / OTP ───────────────────────────────────────────────────────────────
# Production sends to EVERYONE, so SMS_ALLOWLIST must be EMPTY. A non-empty
# allowlist silently suppresses delivery for everyone outside it — the API still
# answers «کد ارسال شد» and carries a delivery_notice, which is correct
# behaviour but is NOT what you want live.
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=CHANGE-ME
KAVENEGAR_OTP_TEMPLATE=digiotp
SMS_ALLOWLIST=

# ── Payments ────────────────────────────────────────────────────────────────
# `sim` is the offline rehearsal gateway — it approves everything. Switch to a
# real gateway BEFORE taking money.
PAYMENT_GATEWAY=CHANGE-ME-zarinpal-or-zibal
ZARINPAL_MERCHANT_ID=CHANGE-ME
ZIBAL_MERCHANT_ID=CHANGE-ME
PAYMENT_FRONTEND_BASE_URL=https://app.example.ir

# ── Moadian (سامانهٔ مودیان) ─────────────────────────────────────────────────
# MOADIAN_MODE=live talks to the REAL Tax Organization. Per-business routing
# (`moadian_tenant_profiles.environment`) still decides sandbox vs live, so a
# business can be rehearsed on the sandbox while the platform is live.
MOADIAN_MODE=live
MOADIAN_TRANSPORT=selftsp
MOADIAN_BASE_URL=https://tp.tax.gov.ir/req/api
MOADIAN_TIMEOUT_SECONDS=30

# FRESH key, generated on the production host and NEVER reused from dev — it
# encrypts every stored taxpayer private key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOADIAN_CRED_KEY=CHANGE-ME-fresh-fernet-key

# Iran egress. Required only if the production host is NOT already in Iran; if
# it is, leave PROXY_ENABLED=false and delete the URL.
MOADIAN_PROXY_ENABLED=false
MOADIAN_PROXY_URL=

# Comma-separated tenant ids allowed to submit LIVE. Start EMPTY and add
# businesses deliberately — an empty allowlist blocks all live submission, which
# is the safe direction to fail on day one.
MOADIAN_LIVE_BUSINESS_ALLOWLIST=

# ── Commission defaults ─────────────────────────────────────────────────────
# The tier-1 fallback used before an admin sets a global rate in the panel.
# Tier 2 falls back to ZERO by design — two-tier only costs money once someone
# deliberately turns it on.
DEFAULT_COMMISSION_PERCENT=15

# ── Backups ─────────────────────────────────────────────────────────────────
# Consumed by scripts/backup_db.sh (systemd timer — see the runbook).
KEEP_DAILY=7
KEEP_WEEKLY=4

# ── Things that must NOT appear in a production .env ─────────────────────────
#   · any *_test database name
#   · SMS_ALLOWLIST with entries
#   · DEBUG=true / SWAGGER_AUTO_AUTH_ENABLED=true
#   · a MOADIAN_CRED_KEY copied from dev (it would make dev able to decrypt
#     production taxpayer keys)
#   · BACKEND_CORS_ORIGINS=*
